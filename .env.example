# Docker Compose configuration. Copy to .env and fill in every secret below:
#   JWT_SECRET:           openssl rand -hex 32
#   MySQL / RabbitMQ:     openssl rand -hex 16   (hex keeps the RabbitMQ URL valid)
# Upgrading an existing mysql_data volume? MySQL keeps the passwords it was created with,
# so set MYSQL_ROOT_PASSWORD=root123456 and MYSQL_PASSWORD=ecommerce123 (the old defaults)
# or recreate the volume.
JWT_SECRET=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
RABBITMQ_PASSWORD=
CORS_ORIGIN=http://localhost:3000
# Browser-accessible API URL; changing it requires rebuilding the frontend.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
