{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "电商平台后端服务",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc && node scripts/build-openapi.cjs",
    "test": "jest",
    "start": "node dist/index.js",
    "migrate": "node dist/database/migrate.js",
    "migrate:account-security": "node dist/database/migrate-account-security.js",
    "schema:check": "node dist/database/check-account-schema.js",
    "migrate:dev": "ts-node src/database/migrate.ts",
    "seed": "node dist/database/seed.js",
    "seed:dev": "ts-node src/database/seed.ts",
    "sync-es": "node dist/database/sync-es.js",
    "sync-es:dev": "ts-node src/database/sync-es.ts",
    "migrate-coupon": "node dist/database/migrate-coupon.js",
    "migrate-coupon:dev": "ts-node src/database/migrate-coupon.ts",
    "migrate-sku": "node dist/database/migrate-sku.js",
    "migrate-sku:dev": "ts-node src/database/migrate-sku.ts",
    "migrate-address": "node dist/database/migrate-address.js",
    "migrate-address:dev": "ts-node src/database/migrate-address.ts",
    "migrate-review": "node dist/database/migrate-review.js",
    "migrate-review:dev": "ts-node src/database/migrate-review.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "amqplib": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "pino": "^10.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
