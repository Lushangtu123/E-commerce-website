# ================================
# 后端环境变量配置示例
# ================================
# 复制此文件为 .env 并填写实际的配置值
# 注意：.env 文件包含敏感信息，请勿提交到版本控制系统

# ================================
# 应用配置
# ================================
# 运行环境：development | production | test
NODE_ENV=development

# 服务端口
PORT=3001

# ================================
# MySQL 数据库配置
# ================================
# 数据库主机地址
DB_HOST=localhost

# 数据库端口
DB_PORT=3306

# 数据库用户名
DB_USER=ecommerce

# 数据库密码
DB_PASSWORD=ecommerce123

# 数据库名称
DB_NAME=ecommerce

# Aiven / Vercel：启用证书校验，并使用小连接池
# DB_SSL=true
# DB_SSL_CA_BASE64=从 Aiven 下载的 CA 证书的 Base64 内容
# DB_CONNECTION_LIMIT=2

# ================================
# Redis 缓存配置
# ================================
# Redis 主机地址
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379

# Redis 密码（可选，如果没有设置密码请留空或删除此行）
REDIS_PASSWORD=

# Upstash TCP 使用 rediss URL；商城键前缀不可为空
# REDIS_URL=rediss://default:password@your-endpoint.upstash.io:6379
REDIS_KEY_PREFIX=ecommerce:
# RATE_LIMIT_STORE=redis

# Upstash QStash POST /api/internal/order-timeouts 的 Bearer 密钥
# CRON_SECRET=至少32字符的随机密钥
# 首次生产初始化管理员时使用，勿上传到前端或提交仓库
# ADMIN_BOOTSTRAP_PASSWORD=至少16字符的强密码

# ================================
# Elasticsearch 配置
# ================================
# 可选。Elasticsearch HTTP 地址；不设置时商品搜索使用 MySQL，ES 不可用时也会自动回退到 MySQL
# 首次启用或重建索引：npm run sync-es:dev
ELASTICSEARCH_URL=http://localhost:9200

# ================================
# RabbitMQ 消息队列配置
# ================================
# 可选。RabbitMQ 连接 URL，用于下单 30 分钟后精确取消未支付订单；
# 不设置或连接失败时不影响启动，超时订单由每 5 分钟一次的定时任务取消
# 格式：amqp://username:password@host:port
RABBITMQ_URL=amqp://admin:admin123@localhost:5672

# ================================
# JWT 认证配置
# ================================
# JWT 密钥（生产环境请使用强随机字符串）
# 建议使用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT 过期时间（可选，默认 7d）
JWT_EXPIRES_IN=7d

# 管理员和用户均使用 JWT_SECRET，令牌身份由服务端分别校验。

# ================================
# 文件上传配置（可选）
# ================================
# 文件上传目录
UPLOAD_DIR=./uploads

# 最大文件大小（字节）
MAX_FILE_SIZE=5242880

# ================================
# 密码找回邮件（未配置时关闭找回功能）
# ================================
# 默认使用 Resend API；也可使用个人 Gmail 的 SMTP（无需独立域名）。
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=填写邮件服务密钥
# EMAIL_FROM=Store <noreply@your-domain.example>
# APP_URL=https://your-store.example
# APP_URL 仅允许可信网站根地址，不包含路径、查询或片段。
# Gmail：EMAIL_PROVIDER=gmail，以下两项仅配置到后端。
# GMAIL_USER=your-store@gmail.com
# GMAIL_APP_PASSWORD=Google两步验证后生成的16字符应用专用密码
# Gmail 发件人为 GMAIL_USER；EMAIL_FROM、RESEND_API_KEY 不用于 Gmail。
# 不使用 Google 登录密码，不开启 SMTP 调试日志。

# ================================
# 短信服务配置（可选，未来功能）
# ================================
# SMS_PROVIDER=aliyun
# SMS_ACCESS_KEY=your-access-key
# SMS_SECRET_KEY=your-secret-key

# ================================
# 支付模式与未来商户接入
# ================================
# 默认禁用收款。demo 仅用于本地或 Vercel Preview，生产环境强制禁用模拟支付。
PAYMENT_MODE=disabled
# 当前没有真实支付适配器，以下商户变量尚未使用。
# 支付宝
# ALIPAY_APP_ID=your-alipay-app-id
# ALIPAY_PRIVATE_KEY=your-alipay-private-key
# ALIPAY_PUBLIC_KEY=your-alipay-public-key

# 微信支付
# WECHAT_APP_ID=your-wechat-app-id
# WECHAT_MCH_ID=your-wechat-merchant-id
# WECHAT_API_KEY=your-wechat-api-key

# ================================
# 日志配置（可选）
# ================================
# 日志级别：error | warn | info | debug
LOG_LEVEL=info

# 日志文件路径
LOG_FILE=./logs/app.log

# ================================
# 跨域配置（可选）
# ================================
# 允许的前端域名（逗号分隔）。只有列出的来源能跨域携带登录 Cookie；* 放行所有来源但不带 Cookie
CORS_ORIGIN=http://localhost:3000

# ================================
# 限流配置（可选）
# ================================
# API 请求限流：每个 IP 在时间窗口内的最大请求数
RATE_LIMIT_MAX=100

# 限流时间窗口（毫秒）
RATE_LIMIT_WINDOW=60000

# 登录/注册限流：每个 IP 在时间窗口内的最大尝试次数（防暴力破解）
RATE_LIMIT_AUTH_MAX=10

# ================================
# 其他配置
# ================================
# 是否启用 API 文档
ENABLE_API_DOCS=true

# API 文档路径
API_DOCS_PATH=/api-docs
